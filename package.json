{
  "name": "scientific-plot-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Figrava v1.0 (Scientific Figures & Data Visualization) — Cross-platform scientific visualization and data analysis desktop application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "desktop": "npm run build && cargo run -p scientific-plot-studio",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.2.0",
    "echarts": "^5.6.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
