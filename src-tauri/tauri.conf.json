{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Figrava",
  "version": "1.0.0",
  "identifier": "org.figrava.studio",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Figrava v1.0 (Scientific Figures & Data Visualization)",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "Copyright © 2026 Figrava Contributors",
    "shortDescription": "Figrava — Scientific Figures & Data Visualization",
    "longDescription": "Cross-platform scientific visualization and data analysis desktop application",
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
